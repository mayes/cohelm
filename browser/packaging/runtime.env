# What the packaged Cohelm bundles beside the browser, pinned with checksums.
# Update the version and every checksum together; the scripts refuse a file
# that doesn't match.

# Node runtime for Chrome DevTools MCP (nodejs.org, MIT). Checksums are from
# the release's SHASUMS256.txt.
NODE_VERSION=26.13.1
NODE_SHA256_DARWIN_ARM64=aec2514ea1ceb2ba52455e9ec65986f6749a06dd759e5db2a72e6889668c9735
NODE_SHA256_DARWIN_X64=82bb96078a24ca50b9c9a38f2379e6be6d87171fcd400fc14c8934b3bce96e2f
NODE_SHA256_WIN_X64=e2edda75bfb089654705cf65a13b58933bfd5f57148e8ebda916f58a2474f1f7

# Chrome DevTools MCP (Apache 2.0). Keep in step with DEVTOOLS_MCP_VERSION in
# helper/src/backend.rs. The integrity is npm's sha512 for the tarball.
DEVTOOLS_MCP_VERSION=1.14.0
DEVTOOLS_MCP_INTEGRITY=sha512-sO7GYmqnvmjQ0l9jiuvw2DyPxi3nBATFbxvNU8ArapYOUXE79z6fbigKuDbJ8/jsi/4OA3OvHlGq83mHLwemGA==
